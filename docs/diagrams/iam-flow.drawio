<root><mxCell id="0"/><mxCell id="1" parent="0"/>
<mxCell id="title" value="管理后台 · 门户端 · 设备端  共用一个统一认证中心 —— 登录与访问业务交互图" style="text;html=1;align=left;verticalAlign=middle;fontSize=24;fontStyle=1;fontColor=#262626;" vertex="1" parent="1"><mxGeometry x="80" y="36" width="1700" height="44" as="geometry"/></mxCell><mxCell id="c2" value="管理后台入口&#xa;管理端用户 · 管理端角色" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#1f3b63;" vertex="1" parent="1"><mxGeometry x="140" y="140" width="340" height="90" as="geometry"/></mxCell><mxCell id="c3" value="门户端入口&#xa;门户用户 · 门户角色" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#2f5520;" vertex="1" parent="1"><mxGeometry x="140" y="280" width="340" height="90" as="geometry"/></mxCell><mxCell id="c4" value="登录失败：&#xa;账号或密码错误" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#7a5c00;" vertex="1" parent="1"><mxGeometry x="180" y="660" width="320" height="90" as="geometry"/></mxCell><mxCell id="c5" value="统一认证中心（三端共用同一登录页与同一套关卡）" style="swimlane;html=1;startSize=34;collapsible=0;resizeParent=0;fillColor=#e1d5e7;swimlaneFillColor=#fbf9fd;strokeColor=#7b4bb5;strokeWidth=3;fontStyle=1;fontColor=#4a2a6b;fontSize=16;align=center;" vertex="1" parent="1"><mxGeometry x="650" y="140" width="940" height="910" as="geometry"/></mxCell><mxCell id="c6" value="是否已登录？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#7a5c00;" vertex="1" parent="c5"><mxGeometry x="110" y="110" width="220" height="110" as="geometry"/></mxCell><mxCell id="c7" value="统一登录页 · 输入账号密码" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;fontColor=#4a2a6b;" vertex="1" parent="c5"><mxGeometry x="70" y="290" width="300" height="70" as="geometry"/></mxCell><mxCell id="c8" value="关卡 A · 身份认证与授权处理" style="swimlane;html=1;startSize=30;collapsible=0;resizeParent=0;fillColor=#e1d5e7;swimlaneFillColor=#ffffff;strokeColor=#9673a6;strokeWidth=2;fontStyle=1;fontColor=#5c2d91;fontSize=13;align=left;spacingLeft=8;" vertex="1" parent="c5"><mxGeometry x="40" y="400" width="360" height="300" as="geometry"/></mxCell><mxCell id="c9" value="身份认证&#xa;识别用户身份" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;fontColor=#4a2a6b;" vertex="1" parent="c8"><mxGeometry x="30" y="55" width="300" height="70" as="geometry"/></mxCell><mxCell id="c10" value="授权处理&#xa;授权确认（需授权的请求）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;fontColor=#4a2a6b;" vertex="1" parent="c8"><mxGeometry x="30" y="175" width="300" height="70" as="geometry"/></mxCell><mxCell id="c11" value="关卡 B · 账号准入" style="swimlane;html=1;startSize=30;collapsible=0;resizeParent=0;fillColor=#ffe6cc;swimlaneFillColor=#fffaf3;strokeColor=#d79b00;strokeWidth=3;fontStyle=1;fontColor=#7c4a00;fontSize=13;align=left;spacingLeft=8;" vertex="1" parent="c5"><mxGeometry x="520" y="300" width="340" height="210" as="geometry"/></mxCell><mxCell id="c12" value="该账号是否属于目标应用&#xa;允许登录的账号范围？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontColor=#7a1f1b;" vertex="1" parent="c11"><mxGeometry x="50" y="55" width="240" height="110" as="geometry"/></mxCell><mxCell id="c13" value="交付授权结果" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;fontColor=#4a2a6b;" vertex="1" parent="c5"><mxGeometry x="70" y="800" width="300" height="70" as="geometry"/></mxCell><mxCell id="c14" value="准入拒绝 → 提示 → 更换账号（不离开登录页）" style="swimlane;html=1;startSize=30;collapsible=0;resizeParent=0;fillColor=#fde7e7;swimlaneFillColor=#ffffff;strokeColor=#b85450;strokeWidth=2;dashed=1;fontStyle=1;fontColor=#7a1f1b;fontSize=13;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="150" y="1005" width="440" height="320" as="geometry"/></mxCell><mxCell id="c15" value="当前账号无权登录该应用，&#xa;请使用对应端的账号" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontColor=#7a1f1b;" vertex="1" parent="c14"><mxGeometry x="30" y="40" width="380" height="90" as="geometry"/></mxCell><mxCell id="c16" value="更换对应端账号&#xa;重新登录" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontColor=#7c4a00;" vertex="1" parent="c14"><mxGeometry x="30" y="170" width="380" height="90" as="geometry"/></mxCell><mxCell id="c17" value="账号与准入规则数据库&#xa;账号 · 角色 · 应用归属 · 准入规则" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=14;fillColor=#ffffff;strokeColor=#666666;fontColor=#333333;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1650" y="340" width="320" height="100" as="geometry"/></mxCell><mxCell id="c18" value="Redis&#xa;登录会话 · 访问临时状态" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=14;fillColor=#ffffff;strokeColor=#666666;fontColor=#333333;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1650" y="710" width="320" height="100" as="geometry"/></mxCell><mxCell id="c19" value="回到最初访问目标（换号后恢复原始请求）" style="swimlane;html=1;startSize=30;collapsible=0;fillColor=#d5e8d4;swimlaneFillColor=#ffffff;strokeColor=#82b366;strokeWidth=2;fontStyle=1;fontColor=#2f5520;fontSize=13;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1650" y="1180" width="420" height="230" as="geometry"/></mxCell><mxCell id="c20" value="进入管理后台（原目标）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#2f5520;" vertex="1" parent="c19"><mxGeometry x="30" y="55" width="360" height="60" as="geometry"/></mxCell><mxCell id="c21" value="进入门户端（原目标）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#2f5520;" vertex="1" parent="c19"><mxGeometry x="30" y="135" width="360" height="60" as="geometry"/></mxCell><mxCell id="c22" value="设备端用户&#xa;设备发起设备授权申请" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#7a5c00;" vertex="1" parent="1"><mxGeometry x="130" y="1590" width="280" height="70" as="geometry"/></mxCell><mxCell id="c23" value="展示设备码&#xa;/ 验证地址" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#1f3b63;" vertex="1" parent="1"><mxGeometry x="490" y="1590" width="280" height="70" as="geometry"/></mxCell><mxCell id="c24" value="用户在浏览器打开&#xa;设备验证页面" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#1f3b63;" vertex="1" parent="1"><mxGeometry x="850" y="1590" width="280" height="70" as="geometry"/></mxCell><mxCell id="c25" value="统一认证中心 · 设备码路径（同一套关卡 A / 关卡 B）" style="swimlane;html=1;startSize=30;collapsible=0;fillColor=#e1d5e7;swimlaneFillColor=#fbf9fd;strokeColor=#7b4bb5;strokeWidth=2;fontStyle=1;fontColor=#4a2a6b;fontSize=13;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1210" y="1530" width="720" height="170" as="geometry"/></mxCell><mxCell id="c26" value="设备验证页&#xa;设备端账号登录" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;fontColor=#4a2a6b;" vertex="1" parent="c25"><mxGeometry x="40" y="60" width="280" height="70" as="geometry"/></mxCell><mxCell id="c27" value="设备端账号准入检查" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontColor=#7c4a00;" vertex="1" parent="c25"><mxGeometry x="400" y="60" width="280" height="70" as="geometry"/></mxCell><mxCell id="c28" value="用户确认设备授权" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#2f5520;" vertex="1" parent="1"><mxGeometry x="2010" y="1590" width="280" height="70" as="geometry"/></mxCell><mxCell id="c29" value="设备获得授权结果&#xa;继续后续业务操作" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#1f3b63;" vertex="1" parent="1"><mxGeometry x="2370" y="1590" width="280" height="70" as="geometry"/></mxCell><mxCell id="c30" value="换号重登后恢复原始访问请求：最终进入用户&#xa;最初想访问的应用，而不是门户首页。" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=6;fontSize=11;fontColor=#5a4500;" vertex="1" parent="1"><mxGeometry x="130" y="1800" width="520" height="130" as="geometry"/></mxCell><mxCell id="c31" value="反向场景：管理端账号访问门户端 → 被门户端准入规则&#xa;拒绝 → 换用门户端账号重新登录 → 重新准入通过 →&#xa;返回最初访问的门户页面。" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=6;fontSize=11;fontColor=#5a4500;" vertex="1" parent="1"><mxGeometry x="700" y="1800" width="560" height="130" as="geometry"/></mxCell><mxCell id="c32" value="设备码路径与浏览器登录共用同一个统一认证中心&#xa;与同一张准入规则库，另有独立的设备授权确认步骤。" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=6;fontSize=11;fontColor=#5a4500;" vertex="1" parent="1"><mxGeometry x="1310" y="1800" width="520" height="130" as="geometry"/></mxCell>
