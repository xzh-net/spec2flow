<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="drawio" version="26.0.0">
<diagram name="订单交易与履约中心业务流程图">
<mxGraphModel dx="1600" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2860" pageHeight="2100">
<root><mxCell id="0"/><mxCell id="1" parent="0"/>
<mxCell id="title" value="订单交易与履约中心 —— 三端下单与履约业务流程图（关卡 A 支付处理 → 关卡 B 履约准入 → 发货交付）" style="text;html=1;align=left;verticalAlign=middle;fontSize=24;fontStyle=1;fontColor=#262626;" vertex="1" parent="1"><mxGeometry x="80" y="36" width="2000" height="44" as="geometry"/></mxCell><mxCell id="c2" value="订单交易与履约中心（三端共用：统一收银台 · 支付处理 · 履约准入 · 状态编排）" style="swimlane;html=1;startSize=34;collapsible=0;resizeParent=0;fillColor=#e1d5e7;swimlaneFillColor=#fbf9fd;strokeColor=#7b4bb5;strokeWidth=3;fontStyle=1;fontColor=#4a2a6b;fontSize=16;align=center;" vertex="1" parent="1"><mxGeometry x="620" y="140" width="1360" height="880" as="geometry"/></mxCell><mxCell id="c3" value="关卡 A · 支付处理（下单受理 → 收单 → 支付回调）" style="swimlane;html=1;startSize=30;collapsible=0;resizeParent=0;fillColor=#e1d5e7;swimlaneFillColor=#ffffff;strokeColor=#7b4bb5;strokeWidth=2;fontStyle=1;fontColor=#5c2d91;fontSize=13;align=left;spacingLeft=8;" vertex="1" parent="c2"><mxGeometry x="40" y="70" width="620" height="760" as="geometry"/></mxCell><mxCell id="c4" value="关卡 B · 履约准入（支付成功 ≠ 一定能履约发货）" style="swimlane;html=1;startSize=30;collapsible=0;resizeParent=0;fillColor=#ffe6cc;swimlaneFillColor=#fffaf3;strokeColor=#d79b00;strokeWidth=3;fontStyle=1;fontColor=#7c4a00;fontSize=13;align=left;spacingLeft=8;" vertex="1" parent="c2"><mxGeometry x="700" y="70" width="620" height="760" as="geometry"/></mxCell><mxCell id="c5" value="已支付被拒 → 提示 → 自动原路退款 → 换规格重下（不离开订单页）" style="swimlane;html=1;startSize=30;collapsible=0;resizeParent=0;fillColor=#fde7e7;swimlaneFillColor=#ffffff;strokeColor=#b85450;strokeWidth=2;dashed=1;fontStyle=1;fontColor=#7a1f1b;fontSize=13;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="140" y="1120" width="580" height="430" as="geometry"/></mxCell><mxCell id="c6" value="运营后台 · 风控人工审核" style="swimlane;html=1;startSize=30;collapsible=0;resizeParent=0;fillColor=#fff7ec;swimlaneFillColor=#ffffff;strokeColor=#d79b00;strokeWidth=2;dashed=1;fontStyle=1;fontColor=#7c4a00;fontSize=13;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="2060" y="640" width="460" height="360" as="geometry"/></mxCell><mxCell id="c7" value="回到最初想购买的订单（换规格重下后完成原目标履约）" style="swimlane;html=1;startSize=30;collapsible=0;resizeParent=0;fillColor=#d5e8d4;swimlaneFillColor=#ffffff;strokeColor=#82b366;strokeWidth=2;fontStyle=1;fontColor=#2f5520;fontSize=13;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1440" y="1150" width="560" height="280" as="geometry"/></mxCell><mxCell id="c8" value="先用后付（独立流程 · 同一交易履约中心与同一套准入规则）" style="swimlane;html=1;startSize=30;collapsible=0;resizeParent=0;fillColor=#e1d5e7;swimlaneFillColor=#ffffff;strokeColor=#7b4bb5;strokeWidth=2;fontStyle=1;fontColor=#5c2d91;fontSize=13;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="140" y="1640" width="2380" height="300" as="geometry"/></mxCell><mxCell id="c9" value="其他接入渠道（次要）" style="swimlane;html=1;startSize=30;collapsible=0;resizeParent=0;fillColor=#f5f5f5;swimlaneFillColor=#ffffff;strokeColor=#999999;strokeWidth=1;dashed=1;fontStyle=1;fontColor=#555555;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="2060" y="1060" width="460" height="240" as="geometry"/></mxCell><mxCell id="c10" value="买家端用户&#xa;发起下单 · 完成支付 · 查看订单" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#1f3b63;" vertex="1" parent="1"><mxGeometry x="140" y="200" width="340" height="90" as="geometry"/></mxCell><mxCell id="c11" value="商家后台&#xa;商品与库存维护 · 处理发货" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#2f5520;" vertex="1" parent="1"><mxGeometry x="140" y="360" width="340" height="90" as="geometry"/></mxCell><mxCell id="c12" value="订单与准入规则数据库&#xa;订单 · SKU 库存 · 商品归属&#xa;履约渠道准入规则 · 风控名单" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=14;fillColor=#ffffff;strokeColor=#666666;fontColor=#333333;fontSize=11;" vertex="1" parent="1"><mxGeometry x="2060" y="140" width="300" height="120" as="geometry"/></mxCell><mxCell id="c13" value="Redis&#xa;下单快照 · 支付幂等 · 履约临时状态" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=14;fillColor=#ffffff;strokeColor=#666666;fontColor=#333333;fontSize=11;" vertex="1" parent="1"><mxGeometry x="2060" y="300" width="300" height="110" as="geometry"/></mxCell><mxCell id="c14" value="支付网关（微信 / 支付宝 / 银行卡）&#xa;收单 · 原路退款" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;dashed=1;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="2060" y="460" width="300" height="110" as="geometry"/></mxCell><mxCell id="c15" value="反向场景：跨境商品走普通渠道 → 被普通渠道准入规则拒绝 →&#xa;换用跨境收货方式重新提交 → 准入通过 →&#xa;返回最初提交的订单完成发货。" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=6;fontSize=11;fontColor=#5a4500;" vertex="1" parent="1"><mxGeometry x="800" y="1150" width="580" height="170" as="geometry"/></mxCell><mxCell id="c16" value="铁律：支付成功 ≠ 一定能履约发货。关卡 A（支付处理）与&#xa;关卡 B（履约准入）是两个独立判断，顺序不可颠倒。" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=6;fontSize=11;fontColor=#5a4500;" vertex="1" parent="1"><mxGeometry x="800" y="1360" width="580" height="150" as="geometry"/></mxCell><mxCell id="c17" value="买家选定商品发起下单&#xa;交易中心生成订单并占用库存预占" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;fontColor=#4a2a6b;" vertex="1" parent="c3"><mxGeometry x="30" y="50" width="560" height="70" as="geometry"/></mxCell><mxCell id="c18" value="统一收银台（三端共用同一张）· 买家选择支付方式" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;fontColor=#4a2a6b;" vertex="1" parent="c3"><mxGeometry x="30" y="160" width="560" height="70" as="geometry"/></mxCell><mxCell id="c19" value="向支付网关发起收单（微信 / 支付宝 / 银行卡）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;fontColor=#4a2a6b;" vertex="1" parent="c3"><mxGeometry x="30" y="270" width="560" height="70" as="geometry"/></mxCell><mxCell id="c20" value="支付成功？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#7a5c00;" vertex="1" parent="c3"><mxGeometry x="110" y="380" width="400" height="130" as="geometry"/></mxCell><mxCell id="c21" value="支付未完成（扣款失败 / 超时）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontColor=#7a1f1b;" vertex="1" parent="c3"><mxGeometry x="30" y="570" width="260" height="80" as="geometry"/></mxCell><mxCell id="c22" value="大额支付二次验证&#xa;支付风控复核" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontColor=#7c4a00;" vertex="1" parent="c3"><mxGeometry x="330" y="570" width="260" height="80" as="geometry"/></mxCell><mxCell id="c23" value="获取当前订单身份 + 买家实际选择的履约渠道 / 收货地址" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;fontColor=#4a2a6b;" vertex="1" parent="c4"><mxGeometry x="30" y="50" width="560" height="70" as="geometry"/></mxCell><mxCell id="c24" value="查询商品归属及履约渠道准入规则&#xa;库存是否充足 · 该 SKU 是否允许此渠道发货&#xa;买家是否在风控名单" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;fontColor=#4a2a6b;" vertex="1" parent="c4"><mxGeometry x="30" y="160" width="560" height="90" as="geometry"/></mxCell><mxCell id="c25" value="当前订单是否满足目标&#xa;履约渠道的准入条件？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontColor=#7a1f1b;" vertex="1" parent="c4"><mxGeometry x="110" y="300" width="400" height="150" as="geometry"/></mxCell><mxCell id="c26" value="履约编排与发货：生成待发货订单并通知商家" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#2f5520;" vertex="1" parent="c4"><mxGeometry x="30" y="500" width="560" height="70" as="geometry"/></mxCell><mxCell id="c27" value="当前订单无法按所选方式履约，已为你原路退款，&#xa;请更换规格或收货方式重新下单" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontColor=#7a1f1b;" vertex="1" parent="c5"><mxGeometry x="30" y="40" width="520" height="110" as="geometry"/></mxCell><mxCell id="c28" value="触发自动原路退款（已支付订单 · 免重复扣款）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontColor=#7c4a00;" vertex="1" parent="c5"><mxGeometry x="30" y="180" width="520" height="70" as="geometry"/></mxCell><mxCell id="c29" value="在订单确认页更换可用规格 / 收货方式重新提交&#xa;（不离开订单页 · 不退回商品首页）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontColor=#7c4a00;" vertex="1" parent="c5"><mxGeometry x="30" y="290" width="520" height="90" as="geometry"/></mxCell><mxCell id="c30" value="命中风控：黑名单 / 异常 → 订单挂起" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontColor=#7c4a00;" vertex="1" parent="c6"><mxGeometry x="30" y="40" width="400" height="70" as="geometry"/></mxCell><mxCell id="c31" value="运营人工审核（放行 / 驳回）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#7a5c00;" vertex="1" parent="c6"><mxGeometry x="30" y="140" width="400" height="70" as="geometry"/></mxCell><mxCell id="c32" value="审核放行&#xa;→ 准入通过履约" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#2f5520;" vertex="1" parent="c6"><mxGeometry x="30" y="250" width="190" height="70" as="geometry"/></mxCell><mxCell id="c33" value="审核驳回&#xa;→ 退款关单" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontColor=#7a1f1b;" vertex="1" parent="c6"><mxGeometry x="240" y="250" width="190" height="70" as="geometry"/></mxCell><mxCell id="c34" value="重新受理 → 重新准入通过&#xa;回到最初提交的订单" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#2f5520;" vertex="1" parent="c7"><mxGeometry x="30" y="45" width="500" height="80" as="geometry"/></mxCell><mxCell id="c35" value="完成最初想购买的那笔订单（发货履约）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#2f5520;" vertex="1" parent="c7"><mxGeometry x="30" y="155" width="500" height="80" as="geometry"/></mxCell><mxCell id="c36" value="① 买家选择先用后付发起下单" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#1f3b63;" vertex="1" parent="c8"><mxGeometry x="30" y="90" width="300" height="110" as="geometry"/></mxCell><mxCell id="c37" value="② 交易中心做信用预授权（不即时扣款）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;fontColor=#4a2a6b;" vertex="1" parent="c8"><mxGeometry x="360" y="90" width="300" height="110" as="geometry"/></mxCell><mxCell id="c38" value="③ 展示先用后付确认页" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;fontColor=#4a2a6b;" vertex="1" parent="c8"><mxGeometry x="690" y="90" width="300" height="110" as="geometry"/></mxCell><mxCell id="c39" value="④ 买家确认先用后付协议" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#1f3b63;" vertex="1" parent="c8"><mxGeometry x="1020" y="90" width="300" height="110" as="geometry"/></mxCell><mxCell id="c40" value="⑤ 检查商品 / 买家是否允许先用后付（准入）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontColor=#7c4a00;" vertex="1" parent="c8"><mxGeometry x="1350" y="90" width="300" height="110" as="geometry"/></mxCell><mxCell id="c41" value="⑥ 准入通过 → 先发货、后扣款" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;fontColor=#4a2a6b;" vertex="1" parent="c8"><mxGeometry x="1680" y="90" width="300" height="110" as="geometry"/></mxCell><mxCell id="c42" value="⑦ 收货确认 → 向支付网关发起延迟扣款" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;fontColor=#4a2a6b;" vertex="1" parent="c8"><mxGeometry x="2010" y="90" width="300" height="110" as="geometry"/></mxCell><mxCell id="c43" value="开放 API 渠道（三方接入 · 准入对所有用户开放）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontColor=#555555;" vertex="1" parent="c9"><mxGeometry x="30" y="45" width="400" height="70" as="geometry"/></mxCell><mxCell id="c44" value="小程序渠道（三方接入 · 准入对所有用户开放）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontColor=#555555;" vertex="1" parent="c9"><mxGeometry x="30" y="145" width="400" height="70" as="geometry"/></mxCell>
